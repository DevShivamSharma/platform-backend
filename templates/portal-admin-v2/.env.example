# Supabase project credentials — the ONLY backend config a deployed portal needs.
# Copy this file to .env and fill in your project's values (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Stripe publishable key for the Billing screens (test key shown as shape).
# Leave blank to run the portal without live payments.
VITE_STRIPE_PUBLISHABLE_KEY=
